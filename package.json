{
  "name": "tieba-account-migrator",
  "version": "0.3.0",
  "private": true,
  "description": "贴吧 CK 导入比特浏览器工具",
  "author": "Fan Zhi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "test:desktop": "npm run build && node test/desktop-smoke.cjs"
  },
  "dependencies": {
    "playwright-core": "^1.64.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.fanzhi.tiebamigrator",
    "productName": "贴吧 CK 导入比特浏览器工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "artifactName": "TiebaMigrator-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
